# Copy to .env (gitignored) in a source checkout. A variable already set in the
# environment wins; installed builds ignore this file.

# Keep your workspace (papers.db, PDFs, notes, AI accounts, logs) outside the
# checkout, so the code folder can be re-cloned or replaced freely.
# PAPERFACT_DATA=D:\Paperfact-data

# Your address for the OpenAlex / Crossref polite pool. Sent with their requests.
# PAPERFACT_EMAIL=you@example.org

# Free Semantic Scholar key for a higher rate limit.
# S2_API_KEY=

# Your own Google desktop OAuth client, for exporting slides to Google Slides.
# PAPERFACT_GOOGLE_CLIENT_ID=
# PAPERFACT_GOOGLE_CLIENT_SECRET=
